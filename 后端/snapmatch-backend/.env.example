APP_NAME=SnapMatch Backend
APP_ENV=development
DEBUG=false

DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/snapmatch?charset=utf8mb4
SECRET_KEY=change-this-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=app/uploads
BACKEND_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_SIZE=10485760

# OCR / VLM 模型配置。课程设计演示默认使用 mock；接入真实模型时在这里填写。
# qwen 会优先用百炼视觉模型做 OCR；未填 Key 时会自动 fallback 到 PaddleOCR/mock。
OCR_PROVIDER=qwen
OCR_MODEL_NAME=qwen-vl-ocr-latest
PADDLEOCR_ENABLED=false
VLM_PROVIDER=qwen
# 二选一即可：推荐使用 DASHSCOPE_API_KEY，兼容阿里云百炼官方示例。
DASHSCOPE_API_KEY=
VLM_API_KEY=
VLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL_NAME=qwen3.6-plus
VLM_ENABLE_THINKING=false
VLM_STREAM=false
VLM_JSON_REPAIR_RETRY=1

# YOLO 区域检测配置。默认 mock 可直接演示；接入自训练权重时改为 real。
YOLO_ENABLED=true
YOLO_MODE=mock
YOLO_MODEL_PATH=weights/best.pt
YOLO_CONFIDENCE=0.35

# 公式识别配置。pix2text 未安装时会自动回退到 OCR 启发式公式提取。
FORMULA_PROVIDER=pix2text
MAX_CONCURRENT_RECOGNITION=2
